{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {},
  "permission": {
    "*": "allow",
    "read": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "task": "allow",
    "skill": "allow",
    "todoread": "allow",
    "todowrite": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "ask",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git branch *": "allow",
      "git show *": "allow",
      "git stash list *": "allow",
      "git remote *": "allow",
      "git fetch *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git merge *": "allow",
      "git rebase *": "ask",
      "git push *": "ask",
      "git reset --soft *": "allow",
      "git reset --hard *": "deny",
      "git push --force *": "deny",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "find *": "allow",
      "which *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "rm *": "ask",
      "rm -rf *": "deny",
      "npm *": "allow",
      "npx *": "allow",
      "node *": "allow",
      "python3 *": "allow"
    }
  }
}
